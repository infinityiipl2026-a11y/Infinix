# Copy this file to .env.local and fill in your details.
# .env.local is already git-ignored, so your credentials won't be committed.

# The Gmail address that will SEND the enquiry emails
GMAIL_USER=youraddress@gmail.com

# A 16-character Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account first.)
GMAIL_APP_PASSWORD=your16charapppassword

# Optional: where enquiries should be delivered.
# If omitted, they are sent to GMAIL_USER itself.
CONTACT_TO_EMAIL=youraddress@gmail.com
